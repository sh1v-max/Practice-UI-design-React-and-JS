---
---

<div class="w-full px-lg py-8" style="margin: 0 auto; max-width: 1400px;">
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
		<!-- Left Column: Inputs & Results -->
		<div class="space-y-6">
			<!-- Color Inputs - Large Visual Design -->
			<div style="display: flex; gap: 24px; align-items: flex-start; margin-bottom: 32px; flex-wrap: wrap;">
				<!-- Foreground Color Box -->
				<div style="flex: 1; min-width: 160px;">
					<div
						id="fgColorSwatch"
						class="rounded-lg border-2 transition-all duration-300 cursor-pointer"
						style="width: 100%; height: 180px; background-color: #111827; border-color: var(--color-hairline); position: relative; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; overflow: hidden;"
					>
						<!-- Invisible native color picker covering entire swatch -->
						<input
							type="color"
							id="fgColorPicker"
							value="#111827"
							style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; border: none; padding: 0; margin: 0;"
						/>
						<!-- Pencil icon on top (pointer-events:none so clicks pass through to input) -->
						<svg style="pointer-events: none; position: relative; z-index: 1;" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
					</div>
					<label class="text-body-sm-strong" style="display: block; margin-bottom: 6px;">Foreground</label>
					<input
						type="text"
						id="fgColorInput"
						placeholder="#111827"
						value="#111827"
						style="width: 100%; padding: 8px 12px; border: 1px solid var(--color-hairline); border-radius: 6px; font-family: 'Geist Mono', monospace; font-size: 0.875rem; background-color: var(--color-canvas-soft); color: var(--color-ink); box-sizing: border-box;"
					/>
				</div>

				<!-- Swap Button -->
				<div style="display: flex; align-items: center; margin-top: 90px; flex: 0 0 auto;">
					<button id="swapButton" style="background: none; border: none; cursor: pointer; padding: 12px; color: var(--color-body); transition: all 0.2s; border-radius: 6px; display: flex; align-items: center; justify-content: center;" title="Swap colors">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
					</button>
				</div>

				<!-- Background Color Box -->
				<div style="flex: 1; min-width: 160px;">
					<div
						id="bgColorSwatch"
						class="rounded-lg border-2 transition-all duration-300 cursor-pointer"
						style="width: 100%; height: 180px; background-color: #ffffff; border-color: var(--color-hairline); position: relative; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; overflow: hidden;"
					>
						<!-- Invisible native color picker covering entire swatch -->
						<input
							type="color"
							id="bgColorPicker"
							value="#ffffff"
							style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; border: none; padding: 0; margin: 0;"
						/>
						<!-- Pencil icon on top -->
						<svg style="pointer-events: none; position: relative; z-index: 1;" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
					</div>
					<label class="text-body-sm-strong" style="display: block; margin-bottom: 6px;">Background</label>
					<input
						type="text"
						id="bgColorInput"
						placeholder="#ffffff"
						value="#ffffff"
						style="width: 100%; padding: 8px 12px; border: 1px solid var(--color-hairline); border-radius: 6px; font-family: 'Geist Mono', monospace; font-size: 0.875rem; background-color: var(--color-canvas-soft); color: var(--color-ink); box-sizing: border-box;"
					/>
				</div>
			</div>

			<!-- Format Tabs -->
			<div class="tab-group mb-lg" style="margin-bottom: 20px;">
				<button class="tab-button active" data-format="hex">HEX</button>
				<button class="tab-button" data-format="rgb">RGB</button>
				<button class="tab-button" data-format="hsl">HSL</button>
			</div>

			<!-- Contrast Ratio -->
			<div class="card-marketing">
				<h3 class="text-display-sm mb-md">Contrast Ratio</h3>
				<div class="flex items-center gap-lg mb-md">
					<div>
						<div class="text-5xl font-semibold text-ink" id="ratioValue">16:1</div>
						<p class="text-body-sm text-body mt-1">
							<span id="qualityLabel">Excellent</span>
						</p>
					</div>
					<svg id="meterSvg" class="w-24 h-24" viewBox="0 0 100 100">
						<circle cx="50" cy="50" r="40" fill="none" stroke="#e5e7eb" stroke-width="8" />
						<circle
							id="meterArc"
							cx="50"
							cy="50"
							r="40"
							fill="none"
							stroke="#10b981"
							stroke-width="8"
							stroke-dasharray="251.2 251.2"
							stroke-dashoffset="0"
							stroke-linecap="round"
							transform="rotate(-90 50 50)"
							class="transition-all duration-500"
						/>
					</svg>
				</div>
			</div>

			<!-- WCAG Results -->
			<div class="card-marketing">
				<h3 class="text-display-sm mb-lg">WCAG Results</h3>
				<div class="space-y-sm">
					<div class="flex items-center justify-between p-md bg-canvas-soft rounded-md">
						<span class="text-body-sm-strong">AA Small Text</span>
						<span id="aaSmall" class="text-sm font-medium">✓ Pass</span>
					</div>
					<div class="flex items-center justify-between p-md bg-canvas-soft rounded-md">
						<span class="text-body-sm-strong">AA Large Text</span>
						<span id="aaLarge" class="text-sm font-medium">✓ Pass</span>
					</div>
					<div class="flex items-center justify-between p-md bg-canvas-soft rounded-md">
						<span class="text-body-sm-strong">AAA Small Text</span>
						<span id="aaaSmall" class="text-sm font-medium">✗ Fail</span>
					</div>
					<div class="flex items-center justify-between p-md bg-canvas-soft rounded-md">
						<span class="text-body-sm-strong">AAA Large Text</span>
						<span id="aaaLarge" class="text-sm font-medium">✓ Pass</span>
					</div>
				</div>
			</div>

			<!-- Smart Auto-Fix (hidden by default) -->
			<div id="autoFixSection" class="card-marketing hidden">
				<h3 class="text-display-sm mb-lg">Smart Auto-Fix</h3>
				<p class="text-body-sm text-body mb-lg">Suggested accessible alternatives:</p>
				<div id="suggestionsContainer" class="space-y-sm">
					<!-- Populated by JS -->
				</div>
			</div>
		</div>

		<!-- Right Column: Preview -->
		<div class="space-y-6">
			<!-- Live Preview -->
			<div class="card-marketing">
				<h3 class="text-display-sm mb-lg">Live Preview</h3>
				<div
					id="previewArea"
					class="p-lg rounded-md"
					style="background-color: #ffffff; color: #111827;"
				>
					<h2 class="text-2xl font-semibold mb-md">Heading</h2>
					<p class="text-body-md mb-md">
						This is a paragraph with sample text to demonstrate the contrast between your foreground and
						background colors.
					</p>
					<button class="btn-primary mb-md">Button</button>
					<a href="#" class="text-link hover:underline text-body-md">Link text</a>
				</div>
			</div>

			<!-- Color Blindness Simulator -->
			<div class="card-marketing">
				<h3 class="text-display-sm mb-lg">Color Blindness</h3>
				<div class="tab-group mb-lg">
					<button class="tab-button active" data-blind="normal">Normal</button>
					<button class="tab-button" data-blind="protanopia">Protanopia</button>
					<button class="tab-button" data-blind="deuteranopia">Deuteranopia</button>
					<button class="tab-button" data-blind="tritanopia">Tritanopia</button>
					<button class="tab-button" data-blind="achromatopsia">Achromatopsia</button>
				</div>
				<div id="blindnessPreviews" class="flex gap-md">
					<div class="flex-1 h-20 rounded-md border border-hairline" style="background-color: #111827;"></div>
					<div class="flex-1 h-20 rounded-md border border-hairline" style="background-color: #ffffff;"></div>
				</div>
			</div>

			<!-- Saved Palettes -->
			<div class="card-marketing">
				<h3 class="text-display-sm mb-lg">Saved Palettes</h3>
				<button id="savePaletteBtn" class="btn-primary w-full mb-lg">
					Save Current Pair
				</button>
				<div id="palettesList" class="space-y-sm">
					<!-- Populated by JS -->
				</div>
			</div>
		</div>
	</div>

	<!-- Below the fold sections -->

	<!-- Color Format Converter -->
	<div class="card-marketing mb-8">
		<h3 class="text-display-sm mb-lg">Color Format Converter</h3>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-md">
			<div>
				<label class="text-body-sm-strong block mb-sm">HEX</label>
				<div class="flex gap-sm items-center">
					<input type="text" id="hexDisplay" class="input-field flex-1" readonly value="#111827" />
					<button
						data-copy="hex"
						style="background: rgba(0, 0, 0, 0.5); color: white; border: none; border-radius: 6px; padding: 6px 10px; font-size: 12px; cursor: pointer; display: flex; align-items: center; gap: 4px; font-family: 'Geist Mono', monospace; transition: background 0.2s; white-space: nowrap;"
						onmouseover="this.style.background = 'rgba(0, 0, 0, 0.7)'"
						onmouseout="this.style.background = 'rgba(0, 0, 0, 0.5)'"
					>
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
						Copy
					</button>
				</div>
			</div>
			<div>
				<label class="text-body-sm-strong block mb-sm">RGB</label>
				<div class="flex gap-sm items-center">
					<input type="text" id="rgbDisplay" class="input-field flex-1" readonly value="rgb(17, 24, 39)" />
					<button
						data-copy="rgb"
						style="background: rgba(0, 0, 0, 0.5); color: white; border: none; border-radius: 6px; padding: 6px 10px; font-size: 12px; cursor: pointer; display: flex; align-items: center; gap: 4px; font-family: 'Geist Mono', monospace; transition: background 0.2s; white-space: nowrap;"
						onmouseover="this.style.background = 'rgba(0, 0, 0, 0.7)'"
						onmouseout="this.style.background = 'rgba(0, 0, 0, 0.5)'"
					>
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
						Copy
					</button>
				</div>
			</div>
			<div>
				<label class="text-body-sm-strong block mb-sm">HSL</label>
				<div class="flex gap-sm items-center">
					<input type="text" id="hslDisplay" class="input-field flex-1" readonly value="hsl(210, 35%, 11%)" />
					<button
						data-copy="hsl"
						style="background: rgba(0, 0, 0, 0.5); color: white; border: none; border-radius: 6px; padding: 6px 10px; font-size: 12px; cursor: pointer; display: flex; align-items: center; gap: 4px; font-family: 'Geist Mono', monospace; transition: background 0.2s; white-space: nowrap;"
						onmouseover="this.style.background = 'rgba(0, 0, 0, 0.7)'"
						onmouseout="this.style.background = 'rgba(0, 0, 0, 0.5)'"
					>
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
						Copy
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Developer Output -->
	<div class="card-marketing mb-8">
		<h3 class="text-display-sm mb-lg">Developer Output</h3>
		<div class="tab-group mb-lg">
			<button class="tab-button active" data-dev-tab="css">CSS Variables</button>
			<button class="tab-button" data-dev-tab="tailwind">Tailwind Classes</button>
		</div>
		<div id="devCssTab" class="block">
			<div class="bg-canvas-soft-2 rounded-md mb-md" style="border-left: 4px solid #0070f3; position: relative; overflow: hidden;">
				<button
					data-copy="css"
					style="position: absolute; top: 8px; right: 8px; background: rgba(0, 0, 0, 0.5); color: white; border: none; border-radius: 6px; padding: 6px 12px; font-size: 12px; cursor: pointer; display: flex; align-items: center; gap: 6px; font-family: 'Geist Mono', monospace; transition: background 0.2s;"
					onmouseover="this.style.background = 'rgba(0, 0, 0, 0.7)'"
					onmouseout="this.style.background = 'rgba(0, 0, 0, 0.5)'"
				>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
					Copy
				</button>
				<div class="p-lg">
					<div class="flex items-center gap-md mb-md" style="font-family: 'Geist Mono', monospace; font-size: 14px;">
						<span style="color: #7928ca;">--foreground:</span>
						<span id="cssColorFg" style="color: #0070f3;">#111827</span>
						<div id="cssSwatchFg" style="width: 16px; height: 16px; border-radius: 4px; border: 1px solid #d1d5db; background-color: #111827;"></div>
					</div>
					<div class="flex items-center gap-md" style="font-family: 'Geist Mono', monospace; font-size: 14px;">
						<span style="color: #7928ca;">--background:</span>
						<span id="cssColorBg" style="color: #0070f3;">#FFFFFF</span>
						<div id="cssSwatchBg" style="width: 16px; height: 16px; border-radius: 4px; border: 1px solid #d1d5db; background-color: #FFFFFF;"></div>
					</div>
				</div>
			</div>
		</div>
		<div id="devTailwindTab" class="hidden">
			<div class="bg-canvas-soft-2 rounded-md mb-md" style="border-left: 4px solid #0070f3; position: relative; overflow: hidden;">
				<button
					data-copy="tailwind"
					style="position: absolute; top: 8px; right: 8px; background: rgba(0, 0, 0, 0.5); color: white; border: none; border-radius: 6px; padding: 6px 12px; font-size: 12px; cursor: pointer; display: flex; align-items: center; gap: 6px; font-family: 'Geist Mono', monospace; transition: background 0.2s;"
					onmouseover="this.style.background = 'rgba(0, 0, 0, 0.7)'"
					onmouseout="this.style.background = 'rgba(0, 0, 0, 0.5)'"
				>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
					Copy
				</button>
				<div class="p-lg">
					<div id="tailwindOutput" style="font-family: 'Geist Mono', monospace; font-size: 14px; line-height: 1.8; color: var(--color-ink);">
						text-slate-900 bg-white
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Toast notification -->
<div id="toast" class="toast hidden">
	<span id="toastMessage">Copied to clipboard!</span>
</div>

<script>
	import { parseColor, toHex, toRgb, toHsl, type RGB } from '../lib/colors';
	import { contrastRatio, wcagResults, qualityLabel, qualityColor } from '../lib/contrast';
	import { suggestFixes } from '../lib/autofix';
	import { toTailwindClasses, toShareUrl } from '../lib/export';
	import { simulate } from '../lib/colorblind';

	let fgColor: RGB = { r: 17, g: 24, b: 39 };
	let bgColor: RGB = { r: 255, g: 255, b: 255 };
	let activeBlindType: 'normal' | 'protanopia' | 'deuteranopia' | 'tritanopia' | 'achromatopsia' = 'normal';
	let savedPalettes: Array<{ name: string; fg: RGB; bg: RGB }> = [];

	// Typed element references
	const fgPicker = document.getElementById('fgColorPicker') as HTMLInputElement;
	const bgPicker = document.getElementById('bgColorPicker') as HTMLInputElement;
	const fgInput  = document.getElementById('fgColorInput')  as HTMLInputElement;
	const bgInput  = document.getElementById('bgColorInput')  as HTMLInputElement;

	function updateAll() {
		updateSwatches();
		updateRatio();
		updateWCAG();
		updatePreview();
		updateMeter();
		updateAutoFix();
		updateFormats();
		updateDeveloperOutput();
		updateUrl();
	}

	function updateSwatches() {
		const fgHex = toHex(fgColor);
		const bgHex = toHex(bgColor);
		const fgSwatch = document.getElementById('fgColorSwatch');
		const bgSwatch = document.getElementById('bgColorSwatch');
		if (fgSwatch) fgSwatch.style.backgroundColor = fgHex;
		if (bgSwatch) bgSwatch.style.backgroundColor = bgHex;
		// Update pencil icon stroke color for contrast
		const fgSvg = fgSwatch?.querySelector('svg');
		const bgSvg = bgSwatch?.querySelector('svg');
		if (fgSvg) fgSvg.setAttribute('stroke', 'white');
		if (bgSvg) {
			// Use dark icon on light backgrounds, light on dark
			const lum = (fgColor.r * 299 + fgColor.g * 587 + fgColor.b * 114) / 1000;
			bgSvg.setAttribute('stroke', lum > 128 ? '#111827' : 'white');
		}
	}

	function updateRatio() {
		const ratio = contrastRatio(fgColor, bgColor);
		const quality = qualityLabel(ratio);
		document.getElementById('ratioValue')!.textContent = `${ratio.toFixed(2)}:1`;
		document.getElementById('qualityLabel')!.textContent = quality;
	}

	function updateWCAG() {
		const ratio = contrastRatio(fgColor, bgColor);
		const results = wcagResults(ratio);
		const set = (id: string, pass: boolean) => {
			const el = document.getElementById(id);
			if (el) {
				el.textContent = pass ? '✓ Pass' : '✗ Fail';
				el.style.color = pass ? '#10b981' : '#ef4444';
			}
		};
		set('aaSmall', results.aaSmall);
		set('aaLarge', results.aaLarge);
		set('aaaSmall', results.aaaSmall);
		set('aaaLarge', results.aaaLarge);
	}

	function updatePreview() {
		const previewArea = document.getElementById('previewArea');
		if (!previewArea) return;
		const blindFg = simulate(fgColor, activeBlindType);
		const blindBg = simulate(bgColor, activeBlindType);
		previewArea.style.backgroundColor = toHex(blindBg);
		previewArea.style.color = toHex(blindFg);

		const blindnessPreviews = document.getElementById('blindnessPreviews');
		if (blindnessPreviews) {
			const children = blindnessPreviews.querySelectorAll('div');
			if (children.length >= 2) {
				(children[0] as HTMLElement).style.backgroundColor = toHex(blindFg);
				(children[1] as HTMLElement).style.backgroundColor = toHex(blindBg);
			}
		}
	}

	function updateMeter() {
		const ratio = contrastRatio(fgColor, bgColor);
		const color = qualityColor(ratio);
		const meterArc = document.getElementById('meterArc');
		if (!meterArc) return;
		const percentage = Math.min(ratio / 21, 1);
		const circumference = 251.2;
		meterArc.style.stroke = color;
		meterArc.style.strokeDashoffset = (circumference * (1 - percentage)).toString();
	}

	function updateAutoFix() {
		const ratio = contrastRatio(fgColor, bgColor);
		const results = wcagResults(ratio);
		const autoFixSection = document.getElementById('autoFixSection');
		if (!autoFixSection) return;

		if (!results.aaSmall || !results.aaLarge || !results.aaaSmall || !results.aaaLarge) {
			autoFixSection.classList.remove('hidden');
			const suggestions = suggestFixes(fgColor, bgColor);
			const container = document.getElementById('suggestionsContainer');
			if (!container) return;
			container.innerHTML = suggestions.map((s, idx) =>
				`<div class="p-md bg-canvas-soft rounded-md flex items-center justify-between">
					<div>
						<div class="text-body-sm-strong">${s.hex}</div>
						<div class="text-body-sm text-body">Ratio: ${s.ratio.toFixed(2)}:1</div>
					</div>
					<button class="btn-primary-sm apply-suggestion" data-index="${idx}">Apply</button>
				</div>`
			).join('');

			container.querySelectorAll('.apply-suggestion').forEach((btn) => {
				btn.addEventListener('click', (e) => {
					const idx = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
					fgColor = suggestions[idx].rgb;
					fgPicker.value = toHex(fgColor);
					fgInput.value = toHex(fgColor);
					updateAll();
				});
			});
		} else {
			autoFixSection.classList.add('hidden');
		}
	}

	function updateFormats() {
		const hexEl = document.getElementById('hexDisplay') as HTMLInputElement | null;
		const rgbEl = document.getElementById('rgbDisplay') as HTMLInputElement | null;
		const hslEl = document.getElementById('hslDisplay') as HTMLInputElement | null;
		if (hexEl) hexEl.value = toHex(fgColor);
		if (rgbEl) rgbEl.value = toRgb(fgColor);
		if (hslEl) hslEl.value = toHsl(fgColor);
	}

	function updateDeveloperOutput() {
		const fgHex = toHex(fgColor);
		const bgHex = toHex(bgColor);
		const cssColorFg  = document.getElementById('cssColorFg');
		const cssColorBg  = document.getElementById('cssColorBg');
		const cssSwatchFg = document.getElementById('cssSwatchFg');
		const cssSwatchBg = document.getElementById('cssSwatchBg');
		const tailwindOut = document.getElementById('tailwindOutput');
		if (cssColorFg)  cssColorFg.textContent = fgHex;
		if (cssColorBg)  cssColorBg.textContent = bgHex;
		if (cssSwatchFg) cssSwatchFg.style.backgroundColor = fgHex;
		if (cssSwatchBg) cssSwatchBg.style.backgroundColor = bgHex;
		if (tailwindOut) tailwindOut.textContent = toTailwindClasses(fgColor, bgColor);
	}

	function updateUrl() {
		window.history.replaceState({}, '', toShareUrl(fgColor, bgColor));
	}

	function showToast(message: string) {
		const toast = document.getElementById('toast');
		const msg   = document.getElementById('toastMessage');
		if (!toast || !msg) return;
		msg.textContent = message;
		toast.classList.remove('hidden');
		setTimeout(() => toast.classList.add('hidden'), 2000);
	}

	function loadFromUrl() {
		const params = new URLSearchParams(window.location.search);
		const fg = params.get('fg');
		const bg = params.get('bg');
		if (fg) { const p = parseColor(`#${fg}`); if (p) fgColor = p; }
		if (bg) { const p = parseColor(`#${bg}`); if (p) bgColor = p; }
		fgPicker.value = toHex(fgColor);
		fgInput.value  = toHex(fgColor);
		bgPicker.value = toHex(bgColor);
		bgInput.value  = toHex(bgColor);
	}

	function loadPalettes() {
		const stored = localStorage.getItem('contrastlab-palettes');
		if (stored) {
			try { savedPalettes = JSON.parse(stored); renderPalettes(); } catch {}
		}
	}

	function savePalette() {
		const fgHex = toHex(fgColor);
		const bgHex = toHex(bgColor);
		if (savedPalettes.some(p => toHex(p.fg) === fgHex && toHex(p.bg) === bgHex)) {
			showToast('Palette already saved!'); return;
		}
		savedPalettes.push({ name: `${fgHex} / ${bgHex}`, fg: fgColor, bg: bgColor });
		localStorage.setItem('contrastlab-palettes', JSON.stringify(savedPalettes));
		renderPalettes();
		showToast('Palette saved!');
	}

	function deletePalette(idx: number) {
		savedPalettes.splice(idx, 1);
		localStorage.setItem('contrastlab-palettes', JSON.stringify(savedPalettes));
		renderPalettes();
		showToast('Palette deleted!');
	}

	function renderPalettes() {
		const list = document.getElementById('palettesList');
		if (!list) return;
		list.innerHTML = savedPalettes.map((p, idx) => {
			const fgHex = toHex(p.fg);
			const bgHex = toHex(p.bg);
			return `<div class="load-palette p-sm bg-canvas-soft rounded-md flex items-center gap-md" data-index="${idx}" style="border: 1px solid var(--color-hairline); cursor: pointer;">
				<div class="flex gap-sm items-center flex-1">
					<div style="width: 20px; height: 20px; border-radius: 4px; background-color: ${fgHex}; border: 1px solid #d1d5db;"></div>
					<div style="width: 20px; height: 20px; border-radius: 4px; background-color: ${bgHex}; border: 1px solid #d1d5db;"></div>
					<span class="text-body-sm-strong">${fgHex} / ${bgHex}</span>
				</div>
				<button class="delete-palette" data-index="${idx}" style="background: none; border: none; cursor: pointer; padding: 0 4px; font-size: 18px; color: var(--color-mute);">×</button>
			</div>`;
		}).join('');

		list.querySelectorAll('.load-palette').forEach((row) => {
			row.addEventListener('click', (e) => {
				if ((e.target as HTMLElement).classList.contains('delete-palette')) return;
				const idx = parseInt((row as HTMLElement).getAttribute('data-index') || '0');
				fgColor = savedPalettes[idx].fg;
				bgColor = savedPalettes[idx].bg;
				fgPicker.value = toHex(fgColor);
				fgInput.value  = toHex(fgColor);
				bgPicker.value = toHex(bgColor);
				bgInput.value  = toHex(bgColor);
				updateAll();
			});
		});

		list.querySelectorAll('.delete-palette').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				const idx = parseInt((btn as HTMLElement).getAttribute('data-index') || '0');
				deletePalette(idx);
			});
		});
	}

	// Color picker event listeners
	fgPicker.addEventListener('input', () => {
		const parsed = parseColor(fgPicker.value);
		if (parsed) { fgColor = parsed; fgInput.value = fgPicker.value; updateAll(); }
	});

	bgPicker.addEventListener('input', () => {
		const parsed = parseColor(bgPicker.value);
		if (parsed) { bgColor = parsed; bgInput.value = bgPicker.value; updateAll(); }
	});

	fgInput.addEventListener('input', () => {
		const parsed = parseColor(fgInput.value);
		if (parsed) { fgColor = parsed; fgPicker.value = toHex(fgColor); updateAll(); }
	});

	bgInput.addEventListener('input', () => {
		const parsed = parseColor(bgInput.value);
		if (parsed) { bgColor = parsed; bgPicker.value = toHex(bgColor); updateAll(); }
	});

	document.getElementById('swapButton')!.addEventListener('click', () => {
		[fgColor, bgColor] = [bgColor, fgColor];
		fgPicker.value = toHex(fgColor);
		fgInput.value  = toHex(fgColor);
		bgPicker.value = toHex(bgColor);
		bgInput.value  = toHex(bgColor);
		updateAll();
	});

	// Color blindness tabs
	document.querySelectorAll('[data-blind]').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const blind = (e.target as HTMLElement).getAttribute('data-blind');
			if (blind) {
				document.querySelectorAll('[data-blind]').forEach((b) => b.classList.remove('active'));
				(e.target as HTMLElement).classList.add('active');
				activeBlindType = blind as typeof activeBlindType;
				updatePreview();
			}
		});
	});

	// Developer tabs
	document.querySelectorAll('[data-dev-tab]').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const tab = (e.target as HTMLElement).getAttribute('data-dev-tab');
			if (tab) {
				document.querySelectorAll('[data-dev-tab]').forEach((b) => b.classList.remove('active'));
				document.getElementById('devCssTab')?.classList.add('hidden');
				document.getElementById('devTailwindTab')?.classList.add('hidden');
				(e.target as HTMLElement).classList.add('active');
				if (tab === 'css') document.getElementById('devCssTab')?.classList.remove('hidden');
				if (tab === 'tailwind') document.getElementById('devTailwindTab')?.classList.remove('hidden');
			}
		});
	});

	// Copy buttons
	document.querySelectorAll('[data-copy]').forEach((btn) => {
		btn.addEventListener('click', async (e) => {
			const type = (e.currentTarget as HTMLElement).getAttribute('data-copy');
			let text = '';
			if (type === 'hex') text = (document.getElementById('hexDisplay') as HTMLInputElement)?.value || '';
			if (type === 'rgb') text = (document.getElementById('rgbDisplay') as HTMLInputElement)?.value || '';
			if (type === 'hsl') text = (document.getElementById('hslDisplay') as HTMLInputElement)?.value || '';
			if (type === 'css') {
				const fg = document.getElementById('cssColorFg')?.textContent || '';
				const bg = document.getElementById('cssColorBg')?.textContent || '';
				text = `--foreground: ${fg};\n--background: ${bg};`;
			}
			if (type === 'tailwind') text = document.getElementById('tailwindOutput')?.textContent || '';
			if (text) { await navigator.clipboard.writeText(text); showToast('Copied!'); }
		});
	});

	document.getElementById('savePaletteBtn')!.addEventListener('click', savePalette);

	// Initialize
	loadFromUrl();
	loadPalettes();
	updateAll();
</script>
