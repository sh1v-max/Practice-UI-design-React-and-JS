---
---

<section class="bg-canvas-soft py-20 w-full">
	<div class="w-full px-lg" style="margin: 0 auto; max-width: 80rem;">
		<div class="mb-12">
			<h2 class="text-display-lg mb-4">Why ContrastLab?</h2>
			<p class="text-body-lg text-body">
				The best contrast checker combines powerful accessibility tools with a beautiful, fast interface.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			<div class="card-marketing">
				<div class="flex items-center gap-2 mb-3">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
					<h3 class="text-display-sm mb-0">Smart Auto-Fix</h3>
				</div>
				<p class="text-body-md text-body">
					Get instant suggestions for accessible color alternatives. One click to apply.
				</p>
			</div>

			<div class="card-marketing">
				<div class="flex items-center gap-2 mb-3">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
					<h3 class="text-display-sm mb-0">Color Blindness</h3>
				</div>
				<p class="text-body-md text-body">
					Simulate how your colors look to users with protanopia, deuteranopia, tritanopia, and more.
				</p>
			</div>

			<div class="card-marketing">
				<div class="flex items-center gap-2 mb-3">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
					<h3 class="text-display-sm mb-0">Save Palettes</h3>
				</div>
				<p class="text-body-md text-body">
					Save your favorite color combinations and access them instantly.
				</p>
			</div>

			<div class="card-marketing">
				<div class="flex items-center gap-2 mb-3">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
					<h3 class="text-display-sm mb-0">Shareable URLs</h3>
				</div>
				<p class="text-body-md text-body">
					Every color pair generates a URL. Share accessibility checks with teammates.
				</p>
			</div>

			<div class="card-marketing">
				<div class="flex items-center gap-2 mb-3">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="19" x2="12" y2="5"></line><line x1="9" y1="8" x2="15" y2="8"></line></svg>
					<h3 class="text-display-sm mb-0">Developer Export</h3>
				</div>
				<p class="text-body-md text-body">
					Generate CSS variables, Tailwind classes, and design tokens with one click.
				</p>
			</div>

			<div class="card-marketing">
				<div class="flex items-center gap-2 mb-3">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
					<h3 class="text-display-sm mb-0">WCAG Education</h3>
				</div>
				<p class="text-body-md text-body">
					Learn accessibility standards as you use the tool. Understand why contrast matters.
				</p>
			</div>
		</div>
	</div>
</section>
