<section class="bg-canvas-soft py-20">
	<div class="container-page">
		<div class="max-w-2xl mb-12">
			<h2 class="text-display-lg mb-4">Why ContrastLab?</h2>
			<p class="text-body-lg text-body">
				The best contrast checker combines powerful accessibility tools with a beautiful, fast interface.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			<div class="card-marketing">
				<h3 class="text-display-sm mb-3">🎯 Smart Auto-Fix</h3>
				<p class="text-body-md text-body">
					Get instant suggestions for accessible color alternatives. One click to apply.
				</p>
			</div>

			<div class="card-marketing">
				<h3 class="text-display-sm mb-3">👓 Color Blindness</h3>
				<p class="text-body-md text-body">
					Simulate how your colors look to users with protanopia, deuteranopia, tritanopia, and more.
				</p>
			</div>

			<div class="card-marketing">
				<h3 class="text-display-sm mb-3">💾 Save Palettes</h3>
				<p class="text-body-md text-body">
					Save your favorite color combinations and access them instantly.
				</p>
			</div>

			<div class="card-marketing">
				<h3 class="text-display-sm mb-3">🔗 Shareable URLs</h3>
				<p class="text-body-md text-body">
					Every color pair generates a URL. Share accessibility checks with teammates.
				</p>
			</div>

			<div class="card-marketing">
				<h3 class="text-display-sm mb-3">📝 Developer Export</h3>
				<p class="text-body-md text-body">
					Generate CSS variables, Tailwind classes, and design tokens with one click.
				</p>
			</div>

			<div class="card-marketing">
				<h3 class="text-display-sm mb-3">📚 WCAG Education</h3>
				<p class="text-body-md text-body">
					Learn accessibility standards as you use the tool. Understand why contrast matters.
				</p>
			</div>
		</div>
	</div>
</section>
