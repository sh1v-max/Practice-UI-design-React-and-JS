---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About ContrastLab"
  description="Learn what ContrastLab is, why accessibility matters, how WCAG works, and who this tool is built for."
>
  <Nav />

  <main>

    <!-- ─── HERO ─────────────────────────────────────────────── -->
    <section style="padding: 72px 24px 56px; text-align: center; border-bottom: 1px solid var(--color-hairline); background: var(--color-canvas-soft);">
      <div style="max-width: 700px; margin: 0 auto;">
        <p style="font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-violet); margin-bottom: 12px;">About ContrastLab</p>
        <h1 style="font-size: clamp(1.875rem, 4vw, 2.75rem); font-weight: 700; color: var(--color-ink); line-height: 1.18; margin-bottom: 18px;">
          Built for people who care<br/>about their users.
        </h1>
        <p style="font-size: 1rem; color: var(--color-body); line-height: 1.75; max-width: 580px; margin: 0 auto;">
          ContrastLab is a free, browser-based WCAG contrast checker — no installs, no account, no paywalls. This page covers what the tool does, why accessibility matters, and how WCAG standards work.
        </p>
      </div>
    </section>

    <!-- ─── WHAT + WHY BUILT ──────────────────────────────────── -->
    <section style="padding: 72px 24px; max-width: 840px; margin: 0 auto;">
      <div style="display: grid; gap: 56px;">

        <div>
          <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-violet); margin-bottom: 10px;">What it is</p>
          <h2 style="font-size: 1.375rem; font-weight: 700; color: var(--color-ink); margin-bottom: 14px;">What is ContrastLab?</h2>
          <p style="font-size: 0.9375rem; color: var(--color-body); line-height: 1.8; margin-bottom: 14px;">
            ContrastLab is a standalone color contrast checker. You choose a foreground color and a background color — the tool instantly calculates the contrast ratio and tells you whether it meets WCAG 2.2 AA and AAA standards for normal text, large text, and UI components.
          </p>
          <p style="font-size: 0.9375rem; color: var(--color-body); line-height: 1.8;">
            Beyond the ratio, ContrastLab includes a color wheel picker with real-time preview, an eyedropper for sampling directly from your screen, color blindness simulation across five vision types, automatic fix suggestions when you fail, and one-click export to CSS variables or Tailwind classes — all without leaving your browser.
          </p>
        </div>

        <div style="border-top: 1px solid var(--color-hairline); padding-top: 56px;">
          <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-violet); margin-bottom: 10px;">Why it exists</p>
          <h2 style="font-size: 1.375rem; font-weight: 700; color: var(--color-ink); margin-bottom: 14px;">Why it was built</h2>
          <p style="font-size: 0.9375rem; color: var(--color-body); line-height: 1.8; margin-bottom: 14px;">
            Most contrast checkers are either too simple to be useful or buried inside tools that require a subscription, an account, or a specific design environment. ContrastLab is a standalone tool — fast, focused, and free.
          </p>
          <p style="font-size: 0.9375rem; color: var(--color-body); line-height: 1.8;">
            Accessibility audits repeatedly turn up the same failure: text that looks readable but doesn't meet the 4.5:1 threshold, buttons that look fine on a calibrated monitor but fail outdoors on a phone, color tokens updated after the original audit. These are preventable. ContrastLab makes preventing them easy enough that it actually happens.
          </p>
        </div>

      </div>
    </section>

    <!-- ─── WHY ACCESSIBILITY ─────────────────────────────────── -->
    <section style="background: #111; color: #fff; padding: 80px 24px; border-top: 1px solid rgba(255,255,255,0.06);">
      <div style="max-width: 960px; margin: 0 auto;">

        <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #a78bfa; margin-bottom: 12px;">Why it matters</p>
        <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.25rem); font-weight: 700; color: #fff; line-height: 1.2; margin-bottom: 16px;">
          Accessibility is not optional.
        </h2>
        <p style="font-size: 1rem; color: rgba(255,255,255,0.72); line-height: 1.75; max-width: 660px; margin-bottom: 56px;">
          1.3 billion people worldwide live with some form of disability. Poor color contrast is one of the most common — and most fixable — barriers to digital access. Ensuring sufficient contrast isn't just ethical. It's good engineering and, in many jurisdictions, a legal requirement.
        </p>

        <!-- Stats -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; margin-bottom: 56px;">
          {[
            { stat: '1.3B', label: 'People with disabilities globally' },
            { stat: '$6.9T', label: 'Collective spending power of disabled consumers' },
            { stat: '25%', label: 'Of web users experience vision challenges' },
            { stat: '96.3%', label: 'Of top 1M homepages have detected WCAG failures' },
          ].map(({ stat, label }) => (
            <div>
              <div style="font-size: 2.5rem; font-weight: 700; color: #fff; margin-bottom: 6px; line-height: 1;">{stat}</div>
              <p style="font-size: 0.8125rem; color: rgba(255,255,255,0.6); line-height: 1.5;">{label}</p>
            </div>
          ))}
        </div>

        <!-- Who is affected -->
        <div style="margin-bottom: 48px;">
          <h3 style="font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 16px;">Who is affected by poor contrast?</h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px;">
            {[
              { title: 'Low vision users', desc: 'Approximately 246 million people have moderate to severe vision impairment.' },
              { title: 'Color blind users', desc: '8% of men and 0.5% of women have some form of color vision deficiency.' },
              { title: 'Aging users', desc: 'Contrast sensitivity decreases with age — critical for the 1 billion people over 60.' },
              { title: 'Situational impairment', desc: 'Glare, bright sunlight, or a cracked screen can affect any user at any time.' },
            ].map(({ title, desc }) => (
              <div style="padding: 18px 20px; border-radius: 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);">
                <p style="font-size: 0.875rem; font-weight: 700; color: #fff; margin-bottom: 6px;">{title}</p>
                <p style="font-size: 0.8125rem; color: rgba(255,255,255,0.6); line-height: 1.55;">{desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Legal requirements -->
        <div style="padding: 28px 32px; border-radius: 12px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);">
          <h3 style="font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 16px;">Legal requirements</h3>
          <p style="font-size: 0.875rem; color: rgba(255,255,255,0.72); line-height: 1.7; margin-bottom: 16px;">
            Accessible color contrast is legally required or strongly recommended under the following frameworks. Non-compliance has resulted in lawsuits, settlements, and regulatory enforcement in multiple countries.
          </p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px;">
            {[
              { law: 'WCAG 2.2', desc: 'Web Content Accessibility Guidelines — the global technical standard referenced by most legislation.' },
              { law: 'ADA Title III', desc: 'Americans with Disabilities Act — enforced for public-facing websites in the US.' },
              { law: 'EN 301 549', desc: 'European Union harmonised standard for ICT accessibility, mandatory for public sector.' },
              { law: 'AODA', desc: 'Accessibility for Ontarians with Disabilities Act — applies to all Ontario organisations.' },
              { law: 'Section 508', desc: 'US federal law requiring accessible technology for federal agencies and contractors.' },
              { law: 'BS 8878', desc: 'British Standard for web accessibility — a best-practice framework adopted across the UK.' },
            ].map(({ law, desc }) => (
              <div style="display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border-radius: 8px; background: rgba(255,255,255,0.04);">
                <span style="font-size: 0.75rem; font-weight: 700; color: #a78bfa; white-space: nowrap; padding-top: 1px;">{law}</span>
                <span style="font-size: 0.8125rem; color: rgba(255,255,255,0.55); line-height: 1.5;">{desc}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- ─── WCAG GUIDE ────────────────────────────────────────── -->
    <section style="padding: 80px 24px; background: var(--color-canvas-soft); border-top: 1px solid var(--color-hairline);">
      <div style="max-width: 960px; margin: 0 auto;">

        <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-violet); margin-bottom: 12px;">WCAG Guide</p>
        <h2 style="font-size: clamp(1.5rem, 3.5vw, 2.25rem); font-weight: 700; color: var(--color-ink); line-height: 1.2; margin-bottom: 14px;">
          Understanding WCAG 2.2 contrast requirements
        </h2>
        <p style="font-size: 1rem; color: var(--color-body); line-height: 1.75; max-width: 660px; margin-bottom: 48px;">
          WCAG 2.2 defines minimum contrast ratios based on text size and conformance level. Here's what the numbers mean and how to apply them.
        </p>

        <!-- Contrast ratio explainer -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-bottom: 48px;">

          <div style="padding: 28px; border-radius: 12px; border: 1px solid var(--color-hairline); background: var(--color-canvas);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
              <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(121,40,202,0.1); display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-violet)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              </div>
              <h3 style="font-size: 0.9375rem; font-weight: 700; color: var(--color-ink); margin: 0;">What is contrast ratio?</h3>
            </div>
            <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.7; margin-bottom: 12px;">
              Contrast ratio measures the difference in relative luminance between two colors on a scale from <strong>1:1</strong> (no contrast — same color) to <strong>21:1</strong> (maximum — black on white).
            </p>
            <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.7; margin-bottom: 12px;">
              Relative luminance is a linear measure of light intensity, calculated from the sRGB values of each color using a gamma correction curve defined by the W3C.
            </p>
            <div style="padding: 10px 14px; border-radius: 8px; background: var(--color-canvas-soft); border: 1px solid var(--color-hairline); font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-mute);">
              ratio = (L1 + 0.05) / (L2 + 0.05)
            </div>
          </div>

          <div style="padding: 28px; border-radius: 12px; border: 1px solid var(--color-hairline); background: var(--color-canvas);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
              <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(121,40,202,0.1); display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-violet)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              </div>
              <h3 style="font-size: 0.9375rem; font-weight: 700; color: var(--color-ink); margin: 0;">AA vs. AAA</h3>
            </div>
            <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.7; margin-bottom: 12px;">
              <strong style="color: var(--color-ink);">Level AA</strong> is the widely adopted compliance target. It's required by law in the US, EU, Canada, and UK public sector. Most organisations should start here.
            </p>
            <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.7; margin-bottom: 12px;">
              <strong style="color: var(--color-ink);">Level AAA</strong> is enhanced accessibility — stricter ratios that provide a better experience for users with significant vision impairment. Recommended for medical, educational, and government interfaces.
            </p>
            <p style="font-size: 0.8125rem; color: var(--color-mute); font-style: italic;">Start with AA. Aim for AAA wherever the design allows it.</p>
          </div>

          <div style="padding: 28px; border-radius: 12px; border: 1px solid var(--color-hairline); background: var(--color-canvas);">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
              <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(121,40,202,0.1); display: flex; align-items: center; justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-violet)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <h3 style="font-size: 0.9375rem; font-weight: 700; color: var(--color-ink); margin: 0;">What counts as "large text"?</h3>
            </div>
            <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.7; margin-bottom: 12px;">
              WCAG defines large text as at least <strong style="color: var(--color-ink);">18pt (24px)</strong> at normal weight, or at least <strong style="color: var(--color-ink);">14pt (18.67px)</strong> at bold weight (700+).
            </p>
            <p style="font-size: 0.875rem; color: var(--color-body); line-height: 1.7;">
              Large text has a lower minimum ratio because it's easier to read at lower contrast. When in doubt, treat your text as normal size and target 4.5:1.
            </p>
          </div>

        </div>

        <!-- Requirements table -->
        <div style="border-radius: 12px; border: 1px solid var(--color-hairline); overflow: hidden; margin-bottom: 48px;">
          <div style="padding: 16px 20px; background: var(--color-canvas); border-bottom: 1px solid var(--color-hairline);">
            <p style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-mute); margin: 0;">Minimum contrast ratios — WCAG 2.2</p>
          </div>
          <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
              <thead>
                <tr style="background: var(--color-canvas-soft);">
                  <th style="text-align: left; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-mute); padding: 12px 20px; border-bottom: 1px solid var(--color-hairline);">Criterion</th>
                  <th style="text-align: left; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-mute); padding: 12px 16px; border-bottom: 1px solid var(--color-hairline);">Description</th>
                  <th style="text-align: center; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-mute); padding: 12px 16px; border-bottom: 1px solid var(--color-hairline);">AA</th>
                  <th style="text-align: center; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-mute); padding: 12px 16px; border-bottom: 1px solid var(--color-hairline);">AAA</th>
                </tr>
              </thead>
              <tbody>
                {[
                  { criterion: 'Normal Text', desc: 'Body copy, labels, captions under 18px (or bold under 14px)', aa: '4.5:1', aaa: '7:1' },
                  { criterion: 'Large Text', desc: 'Headings and bold text ≥ 18px, or any text ≥ 24px', aa: '3:1', aaa: '4.5:1' },
                  { criterion: 'UI Components', desc: 'Buttons, input borders, focus indicators, icons', aa: '3:1', aaa: '3:1' },
                  { criterion: 'Incidental', desc: 'Decorative images, disabled controls, logos', aa: 'None', aaa: 'None' },
                ].map(({ criterion, desc, aa, aaa }, i) => (
                  <tr style={`border-bottom: ${i < 3 ? '1px solid var(--color-hairline)' : 'none'};`}>
                    <td style="padding: 14px 20px; font-size: 0.875rem; font-weight: 600; color: var(--color-ink);">{criterion}</td>
                    <td style="padding: 14px 16px; font-size: 0.8125rem; color: var(--color-mute);">{desc}</td>
                    <td style="padding: 14px 16px; text-align: center;">
                      <span style={`font-size: 0.875rem; font-weight: 700; color: ${aa === 'None' ? 'var(--color-mute)' : 'var(--color-ink)'};`}>{aa}</span>
                    </td>
                    <td style="padding: 14px 16px; text-align: center;">
                      <span style={`font-size: 0.875rem; font-weight: 700; color: ${aaa === 'None' ? 'var(--color-mute)' : 'var(--color-ink)'};`}>{aaa}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Quality scale -->
        <h3 style="font-size: 1rem; font-weight: 700; color: var(--color-ink); margin-bottom: 16px;">How ContrastLab rates contrast quality</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-bottom: 16px;">
          {[
            { label: 'Poor', range: 'Below 3:1', color: '#ef4444', bg: 'rgba(239,68,68,0.08)', desc: 'Fails all WCAG criteria.' },
            { label: 'Fair', range: '3:1 – 4.49:1', color: '#f59e0b', bg: 'rgba(245,158,11,0.08)', desc: 'Passes large text AA only.' },
            { label: 'Good', range: '4.5:1 – 6.99:1', color: '#10b981', bg: 'rgba(16,185,129,0.08)', desc: 'Passes normal text AA.' },
            { label: 'Excellent', range: '7:1 and above', color: '#059669', bg: 'rgba(5,150,105,0.08)', desc: 'Passes all criteria, including AAA.' },
          ].map(({ label, range, color, bg, desc }) => (
            <div style={`padding: 16px 18px; border-radius: 10px; border: 1px solid ${color}30; background: ${bg};`}>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <span style={`width: 8px; height: 8px; border-radius: 50%; background: ${color}; flex-shrink: 0;`}></span>
                <span style="font-size: 0.875rem; font-weight: 700; color: var(--color-ink);">{label}</span>
              </div>
              <p style="font-size: 0.75rem; font-weight: 600; color: var(--color-mute); margin-bottom: 4px; font-family: var(--font-mono);">{range}</p>
              <p style="font-size: 0.8125rem; color: var(--color-body); line-height: 1.5;">{desc}</p>
            </div>
          ))}
        </div>

        <!-- WCAG Practical tips -->
        <div style="margin-top: 40px; padding: 28px 32px; border-radius: 12px; border: 1px solid var(--color-hairline); background: var(--color-canvas);">
          <h3 style="font-size: 1rem; font-weight: 700; color: var(--color-ink); margin-bottom: 16px;">Practical tips for passing WCAG contrast</h3>
          <ul style="display: flex; flex-direction: column; gap: 12px; list-style: none; padding: 0; margin: 0;">
            {[
              { tip: 'Test at both sizes', detail: 'Check your text at the smallest size it actually appears in production — not just in a design file where zoom can be misleading.' },
              { tip: 'Check your gray palette', detail: 'Neutral grays are the most common failure. A gray that reads well at 16px on white often fails at 13px in a label or caption.' },
              { tip: 'Don\'t rely on color alone to convey meaning', detail: 'WCAG 1.4.1 also requires that information is not conveyed by color alone — use icons, labels, or patterns as secondary indicators.' },
              { tip: 'Test light AND dark mode', detail: 'A color pair that passes in light mode may fail in dark mode. Maintain separate token values for both themes.' },
              { tip: 'Verify focus indicators', detail: 'Keyboard-accessible focus rings must meet the 3:1 ratio against adjacent colors under WCAG 2.4.11 (AA, new in 2.2).' },
            ].map(({ tip, detail }) => (
              <li style="display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--color-hairline);">
                <span style="color: var(--color-violet); font-weight: 700; flex-shrink: 0; margin-top: 1px; font-size: 0.9rem;">→</span>
                <div>
                  <p style="font-size: 0.875rem; font-weight: 700; color: var(--color-ink); margin-bottom: 3px;">{tip}</p>
                  <p style="font-size: 0.8125rem; color: var(--color-body); line-height: 1.6;">{detail}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </section>

    <!-- ─── MISSION ────────────────────────────────────────────── -->
    <section style="border-top: 1px solid var(--color-hairline); padding: 72px 24px;">
      <div style="max-width: 700px; margin: 0 auto; text-align: center;">
        <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-mute); margin-bottom: 20px;">Mission</p>
        <blockquote style="font-size: clamp(1.1rem, 2.5vw, 1.375rem); font-weight: 500; color: var(--color-ink); line-height: 1.65; margin: 0;">
          "ContrastLab exists to lower the cost of doing accessibility right. Checking contrast shouldn't require a plugin, a paid account, or leaving your workflow. It should be fast, accurate, and available whenever you need it."
        </blockquote>
      </div>
    </section>

    <!-- ─── WHO IT'S FOR ──────────────────────────────────────── -->
    <section style="padding: 72px 24px; border-top: 1px solid var(--color-hairline); background: var(--color-canvas-soft);">
      <div style="max-width: 960px; margin: 0 auto;">
        <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-violet); margin-bottom: 10px;">Audience</p>
        <h2 style="font-size: 1.375rem; font-weight: 700; color: var(--color-ink); margin-bottom: 8px;">Who it's for</h2>
        <p style="font-size: 0.9375rem; color: var(--color-mute); margin-bottom: 32px;">ContrastLab fits into the workflow of anyone making color decisions on the web.</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px;">
          {[
            { role: 'Frontend Developers', desc: 'Validate color decisions before committing code. Check CSS variables, Tailwind classes, or any hex value.' },
            { role: 'UI / Brand Designers', desc: 'Verify that palette choices hold up across text sizes before handing off to development.' },
            { role: 'UX Designers', desc: 'Conduct accessibility reviews of existing interfaces and document contrast failures with shareable URLs.' },
            { role: 'Accessibility Specialists', desc: 'Audit products for WCAG compliance. Simulate color blindness and export findings for reports.' },
            { role: 'Students & Educators', desc: 'Learn accessible design principles with a hands-on tool that explains the WCAG thresholds in plain language.' },
          ].map(({ role, desc }) => (
            <div style="padding: 20px 22px; border-radius: 12px; border: 1px solid var(--color-hairline); background: var(--color-canvas);">
              <p style="font-size: 0.875rem; font-weight: 700; color: var(--color-ink); margin-bottom: 6px;">{role}</p>
              <p style="font-size: 0.8125rem; color: var(--color-body); line-height: 1.65;">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── OUR COMMITMENT ────────────────────────────────────── -->
    <section style="padding: 72px 24px; max-width: 840px; margin: 0 auto; border-top: 1px solid var(--color-hairline);">
      <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-violet); margin-bottom: 10px;">Practice what we preach</p>
      <h2 style="font-size: 1.375rem; font-weight: 700; color: var(--color-ink); margin-bottom: 14px;">Our commitment to accessibility</h2>
      <p style="font-size: 0.9375rem; color: var(--color-body); line-height: 1.8; margin-bottom: 14px;">
        It would be inconsistent to build an accessibility tool that isn't itself accessible. ContrastLab is designed to work with keyboard navigation, uses semantic HTML, provides sufficient contrast in both light and dark mode, avoids relying on color alone to communicate state, and includes ARIA attributes where appropriate.
      </p>
      <p style="font-size: 0.9375rem; color: var(--color-body); line-height: 1.8;">
        If you find an accessibility issue in ContrastLab itself, please report it to <a href="mailto:support@contrastlab.com" style="color: var(--color-link); text-decoration: none; border-bottom: 1px solid var(--color-link-bg-soft);">support@contrastlab.com</a>. We treat those reports as high-priority bugs — they're fixed before new features.
      </p>
    </section>

    <!-- ─── ROADMAP ────────────────────────────────────────────── -->
    <section style="padding: 72px 24px; max-width: 840px; margin: 0 auto; border-top: 1px solid var(--color-hairline);">
      <p style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-violet); margin-bottom: 10px;">Coming soon</p>
      <h2 style="font-size: 1.375rem; font-weight: 700; color: var(--color-ink); margin-bottom: 8px;">What's next</h2>
      <p style="font-size: 0.9375rem; color: var(--color-mute); margin-bottom: 28px;">ContrastLab is actively developed. Here's what's on the roadmap.</p>
      <ul style="display: flex; flex-direction: column; gap: 0; list-style: none; padding: 0; margin: 0; border: 1px solid var(--color-hairline); border-radius: 12px; overflow: hidden;">
        {[
          { item: 'APCA (Advanced Perceptual Contrast Algorithm) support alongside WCAG 2.2', status: 'Planned' },
          { item: 'Palette-level auditing — check an entire design system color set at once', status: 'Planned' },
          { item: 'Contrast checking for UI components: buttons, form fields, focus indicators', status: 'Planned' },
          { item: 'Improved mobile experience with touch-optimized color selection', status: 'In progress' },
          { item: 'API access for automated accessibility testing pipelines', status: 'Exploring' },
        ].map(({ item, status }, i) => (
          <li style={`display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 16px 20px; ${i > 0 ? 'border-top: 1px solid var(--color-hairline);' : ''} background: var(--color-canvas);`}>
            <div style="display: flex; gap: 12px; align-items: flex-start;">
              <span style="color: var(--color-violet); font-weight: 700; flex-shrink: 0; margin-top: 1px;">→</span>
              <span style="font-size: 0.875rem; color: var(--color-body); line-height: 1.6;">{item}</span>
            </div>
            <span style={`flex-shrink: 0; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.04em; padding: 3px 8px; border-radius: 20px; ${status === 'In progress' ? 'background: rgba(16,185,129,0.1); color: #059669;' : status === 'Exploring' ? 'background: rgba(245,158,11,0.1); color: #d97706;' : 'background: var(--color-canvas-soft); color: var(--color-mute);'}`}>{status}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ─── CTA ────────────────────────────────────────────────── -->
    <section style="padding: 64px 24px; text-align: center; border-top: 1px solid var(--color-hairline); background: var(--color-canvas-soft);">
      <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--color-ink); margin-bottom: 8px;">Ready to check your contrast?</h2>
      <p style="font-size: 0.9375rem; color: var(--color-mute); margin-bottom: 24px;">Pick two colors and see your WCAG score in seconds.</p>
      <a
        href="/#checker"
        style="display: inline-block; padding: 11px 28px; border-radius: 8px; background: var(--color-ink); color: var(--color-canvas); font-size: 0.875rem; font-weight: 600; text-decoration: none;"
        onmouseover="this.style.opacity='0.85'"
        onmouseout="this.style.opacity='1'"
      >
        Open the checker →
      </a>
    </section>

  </main>

  <Footer />
</Layout>
