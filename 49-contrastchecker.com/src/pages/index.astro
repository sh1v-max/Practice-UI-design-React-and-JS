import FeatureHighlights from '../components/FeatureHighlights.astro';
import WhyAccessibility from '../components/WhyAccessibility.astro';
import WcagExplainer from '../components/WcagExplainer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="ContrastLab">
	<Nav />
	<Hero />
	<section id="checker" style="scroll-margin-top: 80px;">
		<ContrastChecker />
	</section>
	<FeatureHighlights />
	<WhyAccessibility />
	<WcagExplainer />
	<FAQ />
	<Footer />
